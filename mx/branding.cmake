# Load with -C before upstream branding defaults.
set(MX_VPN_PERSONAL_BUILD ON CACHE BOOL "Personal full-tunnel WireGuard client" FORCE)
set(MACOS_NE TRUE CACHE BOOL "Use established Network Extension backend" FORCE)
set(CLIENT_TARGET_NAME MxVPN CACHE STRING "Executable target" FORCE)
set(CLIENT_APPLICATION_NAME "Mx VPN" CACHE STRING "Display name" FORCE)
set(CLIENT_ORGANIZATION_NAME "macsinjobs.MxVPN" CACHE STRING "Isolated settings namespace" FORCE)
set(CLIENT_APP_INSTANCE_NAME "MxVPNInstance" CACHE STRING "Isolated application instance" FORCE)
set(CLIENT_KEYCHAIN_NAME "MxVPN-Keychain" CACHE STRING "Isolated encrypted settings keychain" FORCE)
set(CLIENT_ENABLE_APP_UPDATES 0 CACHE BOOL "Disable upstream updater" FORCE)
set(CLIENT_SWIFT_MODULE_NAME MxVPN CACHE STRING "Valid Swift module identifier" FORCE)
set(CLIENT_SWIFT_OBJC_HEADER_NAME MxVPN-Swift.h CACHE STRING "Swift bridge" FORCE)
set(CLIENT_NETWORK_EXTENSION_NAME MxVPNNetworkExtension CACHE STRING "Extension target" FORCE)
set(BUILD_OSX_APP_IDENTIFIER org.macsinjobs.mxvpn CACHE STRING "Application identifier" FORCE)
set(BUILD_IOS_APP_IDENTIFIER org.macsinjobs.mxvpn CACHE STRING "Network Extension application identifier" FORCE)
set(BUILD_IOS_GROUP_IDENTIFIER group.org.macsinjobs.mxvpn CACHE STRING "App group identifier" FORCE)
set(CLIENT_MACOS_APP_ENTITLEMENTS_PATH "${CMAKE_CURRENT_LIST_DIR}/app.entitlements" CACHE FILEPATH "App entitlements" FORCE)
set(CLIENT_MACOS_NE_ENTITLEMENTS_PATH "${CMAKE_CURRENT_LIST_DIR}/extension.entitlements" CACHE FILEPATH "Extension entitlements" FORCE)
set(CLIENT_MACOS_EXTRA_PLIST_ENTRIES "<key>com.wireguard.macos.app_group_id</key><string>$(DEVELOPMENT_TEAM).group.org.macsinjobs.mxvpn</string>" CACHE STRING "Shared group for tunnel errors and logs" FORCE)
# The upstream team is never valid for this fork. build.sh requires the owner's team.
set(BUILD_VPN_DEVELOPMENT_TEAM "UNCONFIGURED" CACHE STRING "Owner's Apple development team" FORCE)
